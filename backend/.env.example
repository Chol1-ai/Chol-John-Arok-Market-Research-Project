# ==============================================================================
# Foodizo (Ham Towers) & Obunuzi (Opposite YMCA) — Backend Environment Config
# ==============================================================================

# Server Network & Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Canonical PostgreSQL Connection Pool (Port 5432)
DATABASE_URL="postgresql://foodizo_admin:WandegeyaSecure2026@localhost:5432/foodizo_obunuzi_db?schema=public&connection_limit=20"

# JWT Auth Secret (Minimum 32 characters)
JWT_SECRET=kla_foodizo_obunuzi_secure_session_key_2026_kampala_fast_casual
JWT_EXPIRATION_HOURS=12

# Uganda Telecom & Mobile Money Integration
# MTN Uganda MoMo Open API (Collection)
MTN_MOMO_PRIMARY_KEY=sandbox_mtn_momo_primary_key_here
MTN_MOMO_USER_ID=sandbox_mtn_user_uuid
MTN_MOMO_API_KEY=sandbox_mtn_api_key_secret
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_HOST=http://localhost:4000

# Airtel Money Uganda OpenAPI
AIRTEL_MONEY_CLIENT_ID=sandbox_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=sandbox_airtel_client_secret
AIRTEL_MONEY_ENV=sandbox

# Africa's Talking Uganda SMS Gateway (Pickup Notifications & Rider Dispatch)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=sandbox_africastalking_api_key
SMS_SENDER_ID=FOODIZO

# In-Store Hardware Peripherals (Wandegeya LAN)
# Station #4 Expo Pass 80mm ESC/POS Thermal Printer
EXPO_PRINTER_IP=192.168.1.200
EXPO_PRINTER_PORT=9100

# Cash Drawer RJ12 Kick Trigger (0 = Disabled, 1 = Enabled)
CASH_DRAWER_KICK_ENABLED=1

# Telco callbacks (POST /api/v1/payments/webhook; legacy alias /momo/webhook)
# Set a secret in production. When empty, unsigned callbacks are accepted only
# in development/test and rejected with 401 in production.
PAYMENTS_WEBHOOK_SECRET=

# Daily Operations & Nightly Audit Digest (default 21:30 EAT)
DIGEST_CRON_SCHEDULE="30 21 * * *"
DIGEST_RECIPIENT_PHONE=+256772000000
DIGEST_RECIPIENT_EMAIL=zito.mbowe@foodizo.ug

# Public base URL used to build 72-hour /d/<token> digest links.
DIGEST_APP_URL=http://localhost:3000

# Phase 1 has no SMTP transport. Leave false; the digest reports
# emailStatus=NOT_CONFIGURED. Setting true reports FAILED_NOT_IMPLEMENTED.
DIGEST_EMAIL_ENABLED=false

